{
  "name": "buvette-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node --env-file=.env ./node_modules/.bin/knex migrate:latest",
    "migrate:rollback": "node --env-file=.env ./node_modules/.bin/knex migrate:rollback",
    "seed": "node --env-file=.env ./node_modules/.bin/knex seed:run"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "pg": "^8.11.0",
    "puppeteer": "^25.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
